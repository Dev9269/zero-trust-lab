# Auto-detect text files and normalize to LF on commit
* text=auto

# Shell scripts must stay LF
*.sh text eol=lf

# Batch/ PowerShell stay CRLF on checkout
*.ps1 text eol=crlf
*.bat text eol=crlf

# Markdown, YAML, config files — LF
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.rego text eol=lf
*.py text eol=lf
*.json text eol=lf

# Dockerfiles — LF
Dockerfile text eol=lf
