# Copy this file to .env and fill in your own values.
# docker-compose reads .env automatically from this directory.

# oauth2-proxy OIDC client secret (overrides gateway/oauth2-proxy/oauth2-proxy.cfg)
OAUTH2_PROXY_CLIENT_SECRET=ztlab-app-secret-1234567890

# oauth2-proxy cookie encryption secret (overrides gateway/oauth2-proxy/oauth2-proxy.cfg)
OAUTH2_PROXY_COOKIE_SECRET=cdca876137a85aed167802844f7331ae

# Grafana admin password
GF_SECURITY_ADMIN_PASSWORD=ztlab-grafana

# Admin token for WireGuard peer provisioning API
ADMIN_TOKEN=ztlab-admin-token
