# Zero Trust Lab Configuration

# Docker image tags (defaults to local builds)
AUTHZ_BRIDGE_IMAGE=ztlab-authz-bridge
MOCK_OIDC_IMAGE=ztlab-mock-oidc
DEMO_APP_IMAGE=ztlab-demo-app

# Logging
LOG_LEVEL=info

# OPA
OPA_VERSION=0.58.0

# Grafana (used with --profile logging)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ztlab-grafana
